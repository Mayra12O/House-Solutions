# ========================================
# 📦 Archivos y carpetas a ignorar por Git
# ========================================

# ⚙️ Dependencias (npm install las vuelve a instalar)
node_modules/

# 🔐 Archivos sensibles
.env

# 🗑️ Archivos del sistema / temporales
.DS_Store
Thumbs.db

# 🧪 Archivos de logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ⚙️ Configuraciones del editor
.vscode/
.idea/

# 💻 Archivos de producción/local
dist/
build/
tmp/
temp/

# 📄 Archivos del sistema operativo
*.swp
*.swo

# 🧪 Cobertura de pruebas
coverage/

# 🔄 Entorno de entorno (si usas Docker o similares)
.env.local
.env.development
.env.production
.env.test
